{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Performance": {
    "DatabaseConcurrency": 64,
    "DatabaseQueue": 256
  },
  "WeChatWork": {
    "CorpId": "",
    "AgentSecret": "",
    "AgentId": 0,
    "RedirectUri": "http://localhost:5246/wechat/callback", // 必须与可信域名一致
    "AllowedRedirectHosts": "localhost,127.0.0.1,localhost:5173,192.168.1.110,www.ycdcf.com" // 前端回跳地址白名单(防开放重定向)
  },
  "Cors": {
    // 允许跨域访问的前端来源;生产环境在此追加企微工作台前端真实域名(如 https://app.example.com)
    "AllowedOrigins": [ "http://localhost:5173", "http://192.168.1.110:1001", "http://192.168.1.110:1002", "http://www.ycdcf.com:1001" ]
  },
  "Auth": {
    "Secret": "", // 生产必须通过 user-secrets/环境变量注入;留空则回退开发默认密钥
    "TokenExpiryMinutes": 1440 // 登录令牌有效期(分钟)
  },
  "Rbac": {
    "PermissionCheckEnabled": true, // 权限检查总开关;上线出现大量误判 403 时可置 false 一键关闭
    "DefaultLoginRole": "VIEWER" // 新用户(企微免登自动建号)默认绑定角色编码
  }
}
